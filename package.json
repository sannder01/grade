{
  "name": "grade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.8",
    "express": "5.1.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1"
  }
}
