DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/grade
DATABASE_SCHEMA=grade
BETTER_AUTH_URL=http://localhost:3000
# Optional additional exact origins, separated by commas. No wildcards.
TRUSTED_ORIGINS=
BETTER_AUTH_SECRET=
PORT=3000
# Optional: enables search/import from TMDB beyond the starter catalog.
TMDB_READ_TOKEN=
# Optional: Kinopoisk Unofficial API key for Kinopoisk and IMDb ratings.
KINOPOISK_API_KEY=
# For hosted PostgreSQL with a trusted certificate; local/private Railway traffic uses false.
DATABASE_SSL=false
